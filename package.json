{
  "name": "som-style",
  "version": "0.2.1",
  "description": "Mobile-first CSS-in-JS helper with OKLCH design tokens by default",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "import": "./dist/solid.js"
    },
    "./solid-runtime": {
      "types": "./dist/solid-runtime.d.ts",
      "import": "./dist/solid-runtime.js"
    },
    "./vite": {
      "types": "./dist/vite-plugin.d.ts",
      "import": "./dist/vite-plugin.js"
    }
  },
  "files": [
    "dist",
    "scaffold",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/index.js",
    "./dist/solid.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && vitest run"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "csstype": "^3.2.3"
  },
  "peerDependencies": {
    "solid-js": ">=1.8.0",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/types": "^8.0.4",
    "@types/node": "^26.1.1",
    "happy-dom": "^20.11.0",
    "solid-js": "^1.9.14",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "css-in-js",
    "responsive",
    "oklch",
    "solidjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gidul0491/som-style.git"
  },
  "bugs": {
    "url": "https://github.com/gidul0491/som-style/issues"
  },
  "homepage": "https://github.com/gidul0491/som-style#readme",
  "license": "MIT"
}
